# ─── Tarjumi (African language translation — api.thexi.dev) ──────────────────
TARJUMI_API_KEY=

# ─── Prefect Orchestration ───────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGIN=http://localhost:3000

# Shared secret for Prefect → internal trigger endpoints (service-to-service only).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be set in production. All trigger endpoints return 403 without it.
INTERNAL_TRIGGER_SECRET=
LOG_LEVEL=INFO

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kampeni
POSTGRES_USER=kampeni
POSTGRES_PASSWORD=kampeni_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=kampeni_redis_dev
REDIS_URL=redis://:kampeni_redis_dev@localhost:6379/0

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9002
CLICKHOUSE_DB=kampeni_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Auth0 ───────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.kampeni.net
AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET must come from a secrets manager (AWS Secrets Manager / Vault),
# never from a file that could be committed to source control.

# ─── Auth0 (frontend — Vite) ──────────────────────────────────────────────────
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.kampeni.net

# ─── Frontend candidate config ────────────────────────────────────────────────
# The candidate ID used to fetch and display the daily AI briefing.
# For MVP this is a phone number (e.g. +254712345678) that matches CANDIDATE_IDS.
VITE_CANDIDATE_ID=
VITE_SITE_URL=https://kampeni.net

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── YouTube Data API v3 ─────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ─── Facebook / Meta Graph API (legacy — only if you admin target pages) ─────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
FACEBOOK_PAGE_IDS=

# ─── Facebook Playwright scraper ─────────────────────────────────────────────
# Public page URLs to scrape (no login needed). Leave empty for defaults.
# Defaults are baked into FacebookPageScraper (major KE media/political pages).
FB_PAGE_URLS=

# Facebook Playwright forager — keyword search across Facebook.
# Requires a real Facebook account with NO 2FA. Use a dedicated scraping account.
# X/Twitter is out of scope — no free API tier (decision: April 2026).
FB_EMAIL=
FB_PASSWORD=

# ─── Object Storage (MinIO local / swap to S3 in production) ─────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=kampeni
MINIO_ROOT_PASSWORD=kampeni_dev_secret
MINIO_ACCESS_KEY=kampeni
MINIO_SECRET_KEY=kampeni_dev_secret
MINIO_BUCKET=kampeni-raw

# ─── Resend (transactional email) ────────────────────────────────────────────
# Get your API key at https://resend.com — free tier is 3 000 emails/month.
# Must verify kampeni.net domain in the Resend dashboard before sending.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@kampeni.net
EMAIL_FROM_NAME=Kampeni

# ─── Africa's Talking ────────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=

# ─── Anthropic (Claude) — painpoint extraction ───────────────────────────────
ANTHROPIC_API_KEY=

# ─── Briefing service ─────────────────────────────────────────────────────────
# Comma-separated candidate IDs or phone numbers (+254...) to generate briefings for.
# Phone numbers are used directly for SMS delivery at MVP scale.
CANDIDATE_IDS=+254700000000
BRIEFING_LANGUAGE=sw

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=kampeni-raw-data
