# ─── Prefect Orchestration ───────────────────────────────────────────────────
PREFECT_API_URL=http://localhost:4200/api

# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kampeni
POSTGRES_USER=kampeni
POSTGRES_PASSWORD=kampeni_dev

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ─── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=kampeni_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Auth0 ───────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.kampeni.co.ke
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Social APIs ─────────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ─── Object Storage (MinIO local / swap to S3 in production) ─────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=kampeni
MINIO_ROOT_PASSWORD=kampeni_dev_secret
MINIO_ACCESS_KEY=kampeni
MINIO_SECRET_KEY=kampeni_dev_secret
MINIO_BUCKET=kampeni-raw

# ─── Africa's Talking ────────────────────────────────────────────────────────
AT_API_KEY=
AT_USERNAME=

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_RAW_BUCKET=kampeni-raw-data
